# ─── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# ─── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
# Leave unset (or use the SQLite default) for zero-config local development:
#   sqlite+aiosqlite:///./land_records.db  ← default when DB_URL is not set
DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/land_records

# ─── JWT Auth ──────────────────────────────────────────────────────────────────
# ⚠️  CHANGE THIS to a long random secret in production!
#     Generate one: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ─── LLM (OpenAI-compatible) ───────────────────────────────────────────────────
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o
# Optional: override to use Ollama, Azure, or any other OpenAI-compatible endpoint
# LLM_BASE_URL=http://localhost:11434/v1
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_MAX_RETRIES=2

# ─── LM Studio (local vision + extraction) ────────────────────────────────────
# Base URL of LM Studio server (must include /v1)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Vision model for OCR (image → text)
OCR_MODEL=allenai/olmocr-2-7b
# Text model for structured field extraction from OCR text
EXTRACTION_MODEL=qwen/qwen3-vl-8b

# ─── OCR ───────────────────────────────────────────────────────────────────────
# Supported: tesseract | easyocr | trocr | lmstudio
# lmstudio: uses LM Studio vision model for OCR (set LM_STUDIO_BASE_URL above)
# easyocr: requires `pip install easyocr`; auto-falls-back to tesseract if not installed
OCR_PROVIDER=tesseract
# Tesseract language(s) — e.g. "eng" or "eng+hin" for Hindi land records
# easyocr uses the same setting, auto-mapped to 2-letter codes (e.g. "eng+hin" → ["en","hi"])
TESSERACT_LANG=eng
# DPI for PDF→image conversion (300 recommended; 200 for faster processing)
PDF_DPI=300

# ─── Validation ────────────────────────────────────────────────────────────────
# Fields with combined confidence below this are flagged for manual review
REVIEW_THRESHOLD=0.75
# rapidfuzz similarity score (0-100) above which two records are suspected duplicates
FUZZY_THRESHOLD=85.0
# Weights for combining OCR and LLM extraction confidence (must sum to 1.0)
OCR_CONFIDENCE_WEIGHT=0.40
EXTRACTION_CONFIDENCE_WEIGHT=0.60

# ─── Redis ─────────────────────────────────────────────────────────────────────
# Optional. Used for: shared rate limiting across workers, future caching & queuing.
# Leave empty "" to use in-memory rate limiting (single-process dev mode).
# Docker Compose sets this automatically to redis://redis:6379/0
REDIS_URL=

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
# Format: "<count>/<period>"  e.g. "30/minute", "5/second", "1000/hour"
# These are per-IP limits enforced by slowapi.
RATE_LIMIT_UPLOAD=30/minute      # POST /api/v1/documents/upload
RATE_LIMIT_LOGIN=10/minute       # POST /api/v1/auth/login  (brute-force guard)
RATE_LIMIT_API=120/minute        # Global limit across all /api/v1/* routes
