# ─── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# ─── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/land_records

# ─── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ─── LLM (OpenAI-compatible) ───────────────────────────────────────────────────
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o
# Optional: override to use Ollama, Azure, or any other OpenAI-compatible endpoint
# LLM_BASE_URL=http://localhost:11434/v1
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_MAX_RETRIES=2

# ─── OCR ───────────────────────────────────────────────────────────────────────
# Supported: tesseract | easyocr | trocr
OCR_PROVIDER=tesseract
# Tesseract language(s) — e.g. "eng" or "eng+hin" for Hindi land records
TESSERACT_LANG=eng
# DPI for PDF→image conversion (300 recommended; 200 for faster processing)
PDF_DPI=300

# ─── Validation ────────────────────────────────────────────────────────────────
# Fields with combined confidence below this are flagged for manual review
REVIEW_THRESHOLD=0.75
# rapidfuzz similarity score (0-100) above which two records are suspected duplicates
FUZZY_THRESHOLD=85.0
# Weights for combining OCR and LLM extraction confidence (must sum to 1.0)
OCR_CONFIDENCE_WEIGHT=0.40
EXTRACTION_CONFIDENCE_WEIGHT=0.60
